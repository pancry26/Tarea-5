import java.util.ArrayList;

public class Ejercicio4 {

    static class Par<F, S> {

        private F primero;
        private S segundo;

        public Par(F primero, S segundo) {
            this.primero = primero;
            this.segundo = segundo;
        }

        public F getPrimero() {
            return primero;
        }

        public S getSegundo() {
            return segundo;
        }

        @Override
        public String toString() {
            return "(" + primero + ", " + segundo + ")";
        }
    }

    static class Contenedor<F, S> {

        private ArrayList<Par<F, S>> pares;

        public Contenedor() {
            pares = new ArrayList<>();
        }

        public void agregarPar(Par<F, S> par) {
            pares.add(par);
        }

        public Par<F, S> obtenerPar(int indice) {

            if (indice < 0 || indice >= pares.size()) {
                return null;
            }

            return pares.get(indice);
        }

        public ArrayList<Par<F, S>> obtenerTodosLosPares() {
            return pares;
        }

        public void mostrarPares() {

            for (Par<F, S> par : pares) {
                System.out.println(par);
            }
        }
    }

    public static void main(String[] args) {

        Contenedor<String, Integer> contenedor =
                new Contenedor<>();

        contenedor.agregarPar(
                new Par<>("Juan", 20));

        contenedor.agregarPar(
                new Par<>("Pedro", 25));

        contenedor.agregarPar(
                new Par<>("Ana", 22));

        System.out.println("Todos los pares:");
        contenedor.mostrarPares();

        System.out.println();

        System.out.println("Par en posición 1:");
        System.out.println(
                contenedor.obtenerPar(1));

        System.out.println();

        System.out.println("Cantidad de pares: "
                + contenedor.obtenerTodosLosPares().size());
    }
}
